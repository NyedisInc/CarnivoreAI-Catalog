{
  "kind": "cplug",
  "id": "external/cleanyourtv",
  "name": "clean your tv",
  "version": "0.1.1",
  "api_version": 1,
  "min_app_version": "1.16.4",
  "author": "Gathin23 (upstream cleanyourtv); packaged for Carnivore",
  "license": "MIT",
  "tier": "catalog",
  "scope": [
    "global"
  ],
  "icon": "plug",
  "default_enabled": false,
  "runtime": {
    "kind": "process",
    "language": "python",
    "entry": "cleanyourtv_main.py"
  },
  "network_hosts": [],
  "permissions": [],
  "owns": {},
  "data": [
    {
      "id": "tv_records",
      "kind": "folder",
      "path": "files/cyt-data",
      "scope_by": "install",
      "policy": {
        "own": "excluded",
        "share": "excluded",
        "reason": "per TV identity, undo record, batch journal and check results, plus one private adb key per TV (deleted at close-out); the keys pair this computer with one TV, so nothing here is carried to another computer or into a share"
      }
    }
  ]
}
